create_clock -name clk -period 10.0 [get_ports clk]
set_input_delay 2.0 -clock clk [get_ports bump_left]
set_output_delay 2.0 -clock clk [get_ports walk_left]
set_output_delay 2.0 -clock clk [get_ports walk_right]
set_output_delay 2.0 -clock clk [get_ports aaah]
set_output_delay 2.0 -clock clk [get_ports digging]
set_load 5 [get_ports walk_left]
set_load 5 [get_ports walk_right]
set_load 5 [get_ports aaah]
set_load 5 [get_ports digging]
set_input_delay 2.0 -clock clk [get_ports bump_right]
set_input_delay 2.0 -clock clk [get_ports ground]
set_input_delay 2.0 -clock clk [get_ports dig]
